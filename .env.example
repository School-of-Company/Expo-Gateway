# Required in every environment, including local — no special-casing.
CONFIG_SERVER_URL=http://localhost:8888
PROFILE=local

# This gateway instance's own network identity — cannot come from Config
# Server (it returns one shared payload for all replicas of "gateway";
# hostName/ipAddr/instanceId are inherently per-instance).
INSTANCE_HOSTNAME=localhost
INSTANCE_IP_ADDR=127.0.0.1

# Optional. Falls back to the config payload's `port` field, then 3000.
PORT=3000

# Metrics listener (separate from PORT; GET /metrics only). Defaults to
# loopback so it is never exposed on an external interface. A Prometheus
# running in Docker on Linux cannot reach a loopback-bound port through
# host-gateway - set METRICS_HOST to a private interface IP (or 0.0.0.0 behind
# a firewall) in that case.
METRICS_HOST=127.0.0.1
METRICS_PORT=9464
# false stops the listener and omits Prometheus metadata from Eureka.
METRICS_ENABLED=true
# Metadata requires a fixed port and a bind matching INSTANCE_IP_ADDR, or
# 0.0.0.0 (IPv4) / :: (dual stack). dev uses 18206; prod uses 18106.

# Local Grafana (docker-compose.yml), published on 127.0.0.1:3001 only.
GRAFANA_ADMIN_PASSWORD=admin
