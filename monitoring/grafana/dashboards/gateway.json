          },
          "expr": "sum(rate(gateway_http_requests_total{app=~\"$app\"}[1m]))",
          "legendFormat": "",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
